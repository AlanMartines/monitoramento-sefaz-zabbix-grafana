  "title": "Sefaz NF-e Mapa",
  "uid": "sefaz-nfe-mapa",
  "tags": [
    "sefaz",
    "nfe",
    "zabbix"
  ],
  "description": "Mapa de disponibilidade da NF-e por autorizador, sem certificado digital (template Zabbix 'Sefaz NF-e Portal').",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "annotations": {
    "list": []
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "autorizador",
        "label": "Autorizador",
        "type": "query",
        "datasource": {
          "type": "alexanderzobnin-zabbix-datasource",
          "uid": "${DS_ZABBIX}"
        },
        "query": {
          "queryType": "item",
          "group": "Monitoramento Sefaz",
          "host": "Sefaz NF-e Portal",
          "application": "",
          "itemTag": "",
          "item": "/: Status Serviço$/"
        },
        "definition": "Itens '<autorizador>: Status Serviço' do host Sefaz NF-e Portal",
        "regex": "/^(.+): Status Serviço$/",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {},
        "options": [],
        "hide": 0
      },
      {
        "name": "servico",
        "label": "Serviço",
        "type": "query",
        "datasource": {
          "type": "alexanderzobnin-zabbix-datasource",
          "uid": "${DS_ZABBIX}"
        },
        "query": {
          "queryType": "item",
          "group": "Monitoramento Sefaz",
          "host": "Sefaz NF-e Portal",
          "application": "",
          "itemTag": "",
          "item": "/^$autorizador: [^(]+$/"
        },
        "definition": "Serviços do autorizador selecionado (sem o tempo médio)",
        "regex": "/^[^:]+: (?!Tempo Médio$)(.+)$/",
        "refresh": 1,
        "sort": 0,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "type": "geomap",
      "title": "Brasil",
      "datasource": {
        "type": "alexanderzobnin-zabbix-datasource",
        "uid": "${DS_ZABBIX}"
      },
      "description": "Pior status entre os serviços de cada autorizador. Círculo grande: offline (vermelho) ou instável (amarelo). SVAN/SVC-AN ficam em Brasília e SVRS/SVC-RS em Porto Alegre.",
      "gridPos": {
        "h": 28,
        "w": 9,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "alexanderzobnin-zabbix-datasource",
            "uid": "${DS_ZABBIX}"
          },
          "queryType": "0",
          "group": {
            "filter": "Monitoramento Sefaz"
          },
          "host": {
            "filter": "Sefaz NF-e Portal"
          },
          "application": {
            "filter": ""
          },
          "itemTag": {
            "filter": ""
          },
          "item": {
            "filter": "/: Status geral \\(pior serviço\\)$/"
          },
          "functions": [],
          "options": {
            "showDisabledItems": false,
            "skipEmptyValues": false,
            "disableDataAlignment": false,
            "useZabbixValueMapping": false
          }
        }
      ],
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^([^:]+): .*$",
            "renamePattern": "$1"
          }
        },
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "lastNotNull"
            ],
            "mode": "seriesToRows",
            "includeTimeField": false
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Field": "Autorizador",
              "Last *": "Status"
            }
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "alias": "_a",
            "replaceFields": false,
            "binary": {
              "left": "Status",
              "operator": "-",
              "right": "1"
            }
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "alias": "_b",
            "replaceFields": false,
            "binary": {
              "left": "_a",
              "operator": "*",
              "right": "_a"
            }
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "alias": "_c",
            "replaceFields": false,
            "binary": {
              "left": "5",
              "operator": "-",
              "right": "Status"
            }
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "alias": "Severidade",
            "replaceFields": false,
            "binary": {
              "left": "_b",
              "operator": "*",
              "right": "_c"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "_a": true,
              "_b": true,
              "_c": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Offline",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "OK",
                  "color": "green",
                  "index": 1
                },
                "2": {
                  "text": "Instável",
                  "color": "yellow",
                  "index": 2
                },
                "3": {
                  "text": "Erro na coleta",
                  "color": "orange",
                  "index": 3
                },
                "5": {
                  "text": "Sem dados",
                  "color": "#8e8e8e",
                  "index": 4
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e8e8e",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Severidade"
            },
            "properties": [
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 5
              },
              {
                "id": "mappings",
                "value": []
              }
            ]
          }
        ]
      },
      "options": {
        "view": {
          "id": "coords",
          "lat": -15.5,
          "lon": -54,
          "zoom": 3.9,
          "allLayers": true
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": false,
          "showAttribution": true
        },
        "tooltip": {
          "mode": "details"
        },
        "basemap": {
          "type": "xyz",
          "name": "Mapa",
          "config": {
