            "attribution": "Tiles © Esri — Esri, HERE, Garmin, © OpenStreetMap contributors"
          }
        },
        "layers": [
          {
            "type": "markers",
            "name": "Destaque",
            "tooltip": true,
            "location": {
              "mode": "lookup",
              "lookup": "Autorizador",
              "gazetteer": "public/gazetteer/sefaz-autorizadores.json"
            },
            "config": {
              "showLegend": false,
              "style": {
                "size": {
                  "field": "Severidade",
                  "fixed": 0,
                  "min": 0,
                  "max": 26
                },
                "color": {
                  "field": "Status",
                  "fixed": "green"
                },
                "opacity": 0.45,
                "symbol": {
                  "mode": "fixed",
                  "fixed": "img/icons/marker/circle.svg"
                },
                "symbolAlign": {
                  "horizontal": "center",
                  "vertical": "center"
                },
                "rotation": {
                  "fixed": 0,
                  "mode": "mod",
                  "min": -360,
                  "max": 360
                },
                "textConfig": {
                  "fontSize": 12,
                  "offsetX": 0,
                  "offsetY": 0,
                  "textAlign": "center",
                  "textBaseline": "middle"
                }
              }
            }
          },
          {
            "type": "markers",
            "name": "Autorizadores",
            "tooltip": true,
            "location": {
              "mode": "lookup",
              "lookup": "Autorizador",
              "gazetteer": "public/gazetteer/sefaz-autorizadores.json"
            },
            "config": {
              "showLegend": false,
              "style": {
                "size": {
